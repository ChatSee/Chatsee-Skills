# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Local / machine-specific
.DS_Store

# Machine-specific local settings (not shared)
.claude/settings.json
.claude/settings.local.json

# Never commit secrets — keys live in env vars (CHATSEE_MCP_KEY / MCP_API_KEY)
.env
*.env

# Local working notes for Claude Code (personal, not shared)
# CLAUDE.md = coding practices; CODEBASE.md = orientation it points at
CLAUDE.md
CODEBASE.md

# Local apply records + prompt backups written by skill 2
.chatsee/
*.chatsee.bak

# Third-party scripts that carry credentials (e.g. Shubham's register_agent_demo.py
# embeds an RSA private key + a login password) — never commit these
register_agent_demo.py
*_demo_creds.py

# Per-agent env files generated by examples/onboard_agent.py — each holds a LIVE MCP key.
# (`*.env` does NOT match `.env.<name>`, which is why this rule is explicit.)
.env.*
!.env.example

# Dashboard map (local working notes, like CODEBASE.md)
DASHBOARD.md
