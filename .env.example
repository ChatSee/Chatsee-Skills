# Copy to `.env` (gitignored) and fill in. Everything runs LIVE against the real Guardian.
# Never commit real keys or IDs — this file ships placeholders only.

# Skills 2/3/4 — Guardian MCP. No default endpoint: guessing would query the wrong tenant.
CHATSEE_MCP_URL=https://app.chatsee.ai/mcp/  # ChatSee production — must match the key's env
CHATSEE_MCP_KEY=cs-<env>-<tenant_id>-<secret>  # from the ChatSee team; bound to ONE agent
CHATSEE_AGENT="<Your Agent Name>"              # QUOTE it — agent names contain spaces
CHATSEE_MCP_TIMEOUT=300                        # ask_guardian is agentic (~10-60s)

# Skill 1 — the agent's identity (keyless send; from the portal: Settings → Add agent)
CHATSEE_AGENT_ID=<24-hex agent ObjectId>
CHATSEE_TENANT_ID=<24-hex tenant ObjectId>
CHATSEE_ENV=poc                                # app.chatsee.ai (the SDK calls production `poc`). REQUIRED — never defaulted:
                                               # a plausible guess reports to the wrong tenant.

# Skills 1/2 — your agent's system prompt. Skill 1 sends it with each turn; skill 2 writes
# approved remediation rules INTO it, which is how a prompt fix reaches the agent.
CHATSEE_PROMPT_FILE=<path/to/your/agent/PROMPT.md>

# Your agent's OWN model key belongs in ~/.config/chatsee/agent.env, NOT here and NOT in your
# shell — see "Machine-wide config" in README.md. It is shared by every test agent on the
# machine, and keeping it out of the shell stops Claude Code inheriting it (which would
# redirect subscription billing). Put it here only if this one agent needs a different key.
# ANTHROPIC_API_KEY=<key for THIS agent only>

# REST test utilities only (examples/onboard_agent.py, examples/approve_fix.py).
# Optional — derived from CHATSEE_MCP_URL's host when unset, so the two cannot disagree.
# CHATSEE_API_BASE=https://app.chatsee.ai/api
